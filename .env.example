# ─────────────────────────────────────────────────────────────────────────────
# KYNDE Motion website — environment variables (names only; never commit values)
# Copy to .env.local for local development. Set the same names in your host.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site, no trailing slash (used for canonical URLs, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=

# PostgreSQL connection string (e.g. Neon: postgres://user:pass@host/db?sslmode=require)
DATABASE_URL=
# Optional: max connections per server instance (default 5)
DATABASE_POOL_MAX=

# Long random secret (at least 32 characters). Signs contact-form tokens and hashes rate-limit keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Header your host uses for the real client IP (rate limiting only).
# Vercel: x-forwarded-for (default)   Cloudflare: cf-connecting-ip
CLIENT_IP_HEADER=

# ── Media storage ────────────────────────────────────────────────────────────
# "s3" for any S3-compatible bucket (Cloudflare R2 recommended) or "local" (development only)
STORAGE_DRIVER=
# S3-compatible API endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# "auto" for Cloudflare R2; the bucket region for AWS S3
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL where uploaded files are readable, e.g. https://media.yourdomain.com
S3_PUBLIC_BASE_URL=
# Upload limits in megabytes (defaults: 10 for images, 500 for videos)
UPLOAD_MAX_IMAGE_MB=
UPLOAD_MAX_VIDEO_MB=
# Only for a single always-on server with a persistent disk. Never on Vercel or Cloudflare.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=

# ── Enquiry email notifications (optional, via Resend) ───────────────────────
# Without these, enquiries are still saved and shown in the dashboard; no email is sent.
RESEND_API_KEY=
# Verified sender, e.g. "KYNDE Motion <enquiries@yourdomain.com>"
ENQUIRY_FROM_EMAIL=
# Recipient(s), comma-separated. Defaults to flowsyncdigital@gmail.com
ENQUIRY_NOTIFY_TO=

# ── First administrator (Vercel, optional alternative to `npm run admin:create`) ──
# Used by the automatic deploy setup ONLY while no administrator exists.
# Delete ADMIN_BOOTSTRAP_PASSWORD from your host after your first sign-in.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
